# Global Marketing configuration. Copy to .env (never commit .env) or set these in your host's environment.
# Generate secrets with:  python -m gm.keys

# --- Core -----------------------------------------------------------------
GM_ENV=development                      # production | staging | development
GM_SECRET_KEY=                          # required in production: 64 random hex characters
GM_ENCRYPTION_KEY=                      # required in production: Fernet key protecting stored API keys. Back it up!
GM_BASE_URL=http://localhost:4322       # production: your public https:// address (used in emails and webhooks)
GM_INSTANCE_DIR=                        # database, uploads, backups. Production: a folder OUTSIDE public_html, e.g. /home/USER/gm-data
GM_SECURE_COOKIES=0                     # production: 1
GM_TRUST_PROXY=0                        # cPanel/Passenger or nginx in front: 1
GM_ALLOW_SIGNUP=1                       # 0 = invitation only
GM_SESSION_HOURS=12
GM_SESSION_IDLE_MINUTES=60
GM_MAX_UPLOAD_MB=10
GM_MAX_IMPORT_ROWS=50000
GM_INLINE_WORKER=                       # empty: on in development, off in production (use cron instead)
GM_DEV_ADMIN=1                          # development only: creates admin@gm.test (password in instance/dev-admin.txt). Production: 0

# --- Transactional email (verification codes, password resets, alerts) ------
GM_RESEND_API_KEY=                      # empty = local outbox only (nothing is sent)
GM_TRANSACTIONAL_FROM=Global Marketing <no-reply@accounts.example.com>
GM_TRANSACTIONAL_REPLY_TO=
GM_RESEND_WEBHOOK_SECRET=               # whsec_... for https://YOUR-DOMAIN/webhooks/resend/system
# Marketing sending keys and webhook secrets are per workspace: Integrations page (stored encrypted).

# --- AI assistant (optional) ---------------------------------------------
GM_AI_PROVIDER=auto                     # auto | anthropic | rules | mock
GM_ANTHROPIC_API_KEY=
GM_AI_MODEL=claude-opus-5-5
GM_AI_EFFORT=low                        # low | medium | high

# --- Contact discovery crawler ----------------------------------------------
GM_CRAWL_USER_AGENT=GlobalMarketingBot/1.0 (+https://YOUR-DOMAIN/; respects robots.txt)
GM_CRAWL_MAX_PAGES=8
GM_CRAWL_DELAY_SECONDS=1.5
GM_CRAWL_TIMEOUT_SECONDS=10
GM_DNS_TIMEOUT_SECONDS=4
